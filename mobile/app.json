{
  "expo": {
    "name": "AI Coach",
    "slug": "ai-fitness-coach",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Used to log sets by voice.",
          "speechRecognitionPermission": "Used to transcribe your workout notes."
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#07080B"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07080B"
    },
    "backgroundColor": "#07080B",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080B"
      },
      "package": "com.harshiittttt.aicoach",
      "versionCode": 4,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.harshiittttt.aicoach",
      "buildNumber": "1",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Used to transcribe your workout notes.",
        "NSMicrophoneUsageDescription": "Used to log sets by voice."
      }
    },
    "scheme": "aicoach",
    "extra": {
      "eas": {
        "projectId": "1de94ae3-68b8-4370-b704-7066ca7cc025"
      }
    },
    "owner": "goluexpobuild"
  }
}
