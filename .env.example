# LLM provider. Default = Google Gemini (free tier): https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Optional overrides. Any OpenAI-compatible provider works (DeepSeek, Groq, OpenRouter, Ollama...).
# Role = main (agents) | fast (live coaching lines) | critic (safety review; use a DIFFERENT provider than main).
# Resolution: LLM_<ROLE>_<X> -> LLM_<X> -> Gemini default.
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FAST_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash
# LLM_MAIN_BASE_URL=https://api.deepseek.com/v1
# LLM_MAIN_API_KEY=
# LLM_MAIN_MODEL=deepseek-chat

# Optional: ElevenLabs coach voice (free plan = ~10,000 credits/month). Key stays here, never in the app.
ELEVENLABS_API_KEY=
# ELEVEN_CREDITS_PER_CHAR=1.0   # lower to 0.5 if your ElevenLabs usage page shows Flash costs half
# ELEVEN_MONTHLY_CREDITS=9000

# Optional: require `Authorization: Bearer <API_TOKEN>` on every endpoint except /health. Leave empty = no auth (default).
# Use a long random string (e.g. python -c "import secrets;print(secrets.token_urlsafe(32))"). The app sends it once you enter it under "Connect to your coach".
API_TOKEN=

# Deployment: relocate ALL state (fitness.db, tts_cache/) under one directory. Unset = repo root (local dev).
# Docker image sets this to /data. FITNESS_DB (explicit file) still wins if set. See docs/DEPLOY.md.
# FITNESS_DATA_DIR=
